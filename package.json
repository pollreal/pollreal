{
  "name": "versus",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var APP_ENV:development --var SITE_URL:http://localhost:8787 --var PRELAUNCH:0 --var MAKER_CLAIMS:1 --test-scheduled --ip 127.0.0.1 --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply versus-db --local",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "seed": "node scripts/seed-dev.mjs",
    "seed:launch": "node scripts/seed-launch.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@cf-wasm/og": "^0.5.0",
    "@cloudflare/puppeteer": "^1.4.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@simplewebauthn/server": "^14.0.3",
    "hono": "^4.13.14",
    "libphonenumber-js": "^1.13.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
